{
  "name": "scriptnotes",
  "displayName": "Script Notes",
  "description": "Manage and run a list of shell commands with editable items, flags, and user input for arguments.",
  "version": "1.0.2",
  "publisher": "ThiagoFontes",
  "icon": "assets/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThiagoFontes/script_notes.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scriptnotes",
          "title": "Script Notes",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "scriptnotes": [
        {
          "icon": "$(terminal)",
          "type": "webview",
          "id": "commandRunnerWebview",
          "name": "Script Notes"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run copy-assets",
    "copy-assets": "cp -r src/views/*.css out/views/ 2>/dev/null || true && cp -r assets out/ 2>/dev/null || true",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3"
  }
}