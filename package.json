{
  "name": "scriptnotes",
  "displayName": "Script Notes",
  "description": "Manage and run a list of shell commands with editable items, flags, and user input for arguments. UI similar to test explorer.",
  "version": "0.0.1",
  "license": "MIT",
  "publisher": "thiagofontes",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "shell",
    "commands",
    "terminal",
    "scripts",
    "automation",
    "runner"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thiagofontes/script_notes.git"
  },
  "bugs": {
    "url": "https://github.com/thiagofontes/script_notes/issues"
  },
  "homepage": "https://github.com/thiagofontes/script_notes#readme",
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scriptnotes",
          "title": "Script Notes",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "scriptnotes": [
        {
          "icon": "$(terminal)",
          "type": "webview",
          "id": "commandRunnerWebview",
          "name": "Script Notes"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run copy-assets",
    "copy-assets": "cp -r src/views/*.css out/views/ 2>/dev/null || true",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}